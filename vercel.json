{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/bemmp/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/bemmp/((?!api/).*)",
      "destination": "/bemmp/index.html"
    }
  ],
  "headers": [
    {
      "source": "/bemmp/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/bemmp/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cyrix-bemmp-dashboard.vercel.app"
        }
      ],
      "destination": "https://app.cyrix.in/bemmp/$1",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/bemmp/",
      "permanent": false
    }
  ]
}
