# Copy to `.env` on the server, fill in, then `docker compose up -d --build`.
# `.env` is gitignored — it is never committed and never reaches the browser.
#
# docker-compose passes these into the container's environment. The server reads
# them there; a real environment variable wins over the .env.local file used for
# local runs on Windows.

# Enables the Ask-the-data assistant. Users are never prompted for a key.
OPENAI_API_KEY=

# Optional model overrides. The defaults are fine.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Shared-password gate over the whole site, including /api/*.
# Leave blank on a trusted LAN. Set it before exposing the port beyond the office,
# and only ever behind HTTPS — basic auth sends the password on every request.
BEMMP_PASSWORD=
BEMMP_USER=cyrix

# ---------------------------------------------------------------- Supabase --
# Login and the daily penalty meeting. The dashboard's ticket data does not go
# here — only what people type in the meeting, and who is allowed to type it.

# Safe in the browser: it identifies the project, and row-level security is what
# actually decides who reads and writes. Set the same pair in Vercel → Settings →
# Environment Variables so the deployed build gets them at build time.
VITE_SUPABASE_URL=https://vfgswphttrlesvtrjxhw.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only — bypasses row-level security entirely. Used by
# scripts/import-meeting.mjs and the nightly open-call sync. Never expose this to
# the browser and never prefix it with VITE_, which would bundle it.
SUPABASE_URL=https://vfgswphttrlesvtrjxhw.supabase.co
SUPABASE_SERVICE_KEY=
